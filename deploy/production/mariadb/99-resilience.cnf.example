# DESIGN EXAMPLE ONLY.
#
# PRS-001 validates these exact option names and conservative values only in a
# disposable MariaDB 11.4.12 backup/PITR drill. This file is not loaded by the
# current Docker quickstart and is not mounted by any production service.
#
# Disposable validation does not prove production I/O latency, storage capacity,
# retention, scheduling, key custody, monitoring or achieved RPO/RTO. A future
# deployment package must benchmark and approve the final host configuration.

[mariadb]
# Required for binary logging and PITR. The final value must be unique when more
# than one MariaDB server exists; PRS-007 owns any replica-specific settings.
server_id=1

# Record durable data and schema changes for point-in-time recovery.
log_bin=mariadb-bin
binlog_format=ROW
binlog_row_image=FULL

# Conservative durability intent. Changing either value is an explicit RPO
# decision and requires failure testing against the pinned production storage.
sync_binlog=1
innodb_flush_log_at_trx_commit=1

# Fourteen days. Off-host archive verification must complete before local logs
# expire, and retention must exceed any accepted replica lag.
binlog_expire_logs_seconds=1209600

# Do not add replication, GTID, TLS, encryption, audit or performance tuning
# options here without the bounded package that owns and validates them.
