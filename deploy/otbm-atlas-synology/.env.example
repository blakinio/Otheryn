# OTBM Atlas Synology preview defaults.
#
# RECOMMENDED values only. The repository cannot verify the live NAS filesystem
# or port table. Change them in DSM Container Manager if the NAS reports a conflict.

# Generated Atlas copied from the desktop. This folder is mounted read-only.
ATLAS_DATA_DIR=/volume1/docker/otheryn/atlas/current

# Loopback-only host binding keeps the static service private behind DSM Reverse Proxy.
ATLAS_BIND_ADDRESS=127.0.0.1

# Repository allocation check: no existing Otheryn compose/service uses 8095.
# Live NAS availability must still be confirmed by Container Manager at deployment.
ATLAS_HTTP_PORT=8095
